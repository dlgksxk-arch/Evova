{
  "name": "myapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generateStaticSnapshots.mjs",
    "build:preview": "VITE_API_BASE_URL=https://hamdeva.dlgksxk.workers.dev vite build && node scripts/generateStaticSnapshots.mjs",
    "build:worker": "npm run build",
    "build:app": "npm run build && node scripts/pruneAppBundle.mjs",
    "check:android-release": "node scripts/checkAndroidReleaseReadiness.mjs",
    "build:aab": "npm run check:android-release && npm run build:app && cd android && ./gradlew bundleRelease",
    "cap:sync": "npm run build:app && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "preview": "vite preview",
    "deploy:worker": "wrangler deploy",
    "deploy:worker:preview": "wrangler versions upload",
    "deploy:preview": "npm run build:preview && npx wrangler deploy",
    "check:i18n": "node scripts/checkLocaleCompleteness.mjs",
    "check:i18n:all": "node scripts/checkLocaleCompleteness.mjs --all",
    "check:i18n:strict": "node scripts/checkLocaleCompleteness.mjs --strict",
    "seed:board": "node scripts/seedBoardPosts.js"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.1.0",
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "i18next": "^25.8.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wrangler": "4.77.0"
  }
}
