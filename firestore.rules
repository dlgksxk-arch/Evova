rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 사용량 통계 — 서버(Functions)만 쓰기 가능, 클라이언트 읽기 불가
    match /usage/{sessionId} {
      allow read, write: if false;
    }

    // 결제 내역 — 서버만 접근
    match /payments/{paymentId} {
      allow read: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    // 사용자 프로필 — 본인만 읽기/쓰기 가능
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if false;
    }

    match /users/{userId}/creations/{creationId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 생성 이력 — 서버만 쓰기, 본인 데이터만 조회 가능
    match /generations/{generationId} {
      allow read: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if false;
      allow update: if (
        (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin()
      )
      && request.resource.data.uid == resource.data.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'preservedAt',
        'preservedUntil',
        'updatedAt'
      ]);
      allow delete: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // 크레딧 트랜잭션 — 서버만 쓰기, 본인만 읽기 가능
    match /credit_transactions/{logId} {
      allow read: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    // 생성 요청 잠금 — 서버 쓰기, 관리자 읽기 가능
    match /generationRequests/{requestId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 공개 공유 결과 — 생성 결과 이미지만 공개, 원본 업로드 이미지는 금지
    match /publicResults/{resultId} {
      allow read: if true;
      allow create: if
        isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'resultImageUrl', 'language', 'createdAt'])
        && request.resource.data.resultImageUrl is string
        && request.resource.data.resultImageUrl.size() > 0
        && request.resource.data.resultImageUrl.size() <= 1500000
        && (
          !('language' in request.resource.data)
          || request.resource.data.language is string
        );
      allow update, delete: if false;
    }

    // 제안함 — 로그인 사용자만 본인 uid로 작성 가능, 읽기는 차단
    match /suggestions/{suggestionId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // 공개 게시판 — 닉네임과 내용만으로 작성 가능, 모두 읽기 가능
    match /bbsPosts/{postId} {
      allow read: if true;
      allow create: if
        request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 40
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.tempPassword is string
        && request.resource.data.tempPassword.size() >= 4
        && request.resource.data.tempPassword.size() <= 40
        && request.resource.data.deleted is bool;
      allow update: if
        (
          isAdmin()
          || (
            resource.data.tempPassword is string
            && request.resource.data.tempPassword is string
            && request.resource.data.tempPassword == resource.data.tempPassword
          )
        )
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 40
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.deleted is bool;
      allow delete: if isAdmin();
    }

    match /boardNotices/{noticeId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 4000;
      allow delete: if isAdmin();
    }

    // 나머지 모든 문서 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
