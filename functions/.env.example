OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_CLASSIFICATION_MODEL=gpt-4.1-nano
GOOGLE_VIDEO_API_KEY=
GOOGLE_VIDEO_MODEL=veo-3.1-generate-preview
# Paddle API key used for transaction and payment status API calls.
PADDLE_API_KEY=
# Paddle webhook secret used to verify incoming payment webhooks.
PADDLE_WEBHOOK_SECRET=
# Set to production or sandbox depending on the Paddle environment.
PADDLE_ENV=production
# App base URL used for checkout success / cancel return URLs.
APP_BASE_URL=https://hamdeva.com
# Optional Firebase Storage bucket override for Functions uploads/downloads.
APP_STORAGE_BUCKET=hamdeva.appspot.com
# Paddle catalog price ids for each credit pack.
PADDLE_PRICE_ID_STARTER=
PADDLE_PRICE_ID_CREATOR=
PADDLE_PRICE_ID_PRO=
PADDLE_PRICE_ID_STUDIO=
