OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_CLASSIFICATION_MODEL=gpt-4.1-nano
GOOGLE_VIDEO_API_KEY=
GOOGLE_VIDEO_MODEL=veo-3.1-generate-preview
# LemonSqueezy API key used to create checkout URLs.
LEMONSQUEEZY_API_KEY=
# LemonSqueezy store id used for checkout creation.
LEMONSQUEEZY_STORE_ID=
# LemonSqueezy webhook secret used to verify incoming payment webhooks.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Set to production or sandbox depending on the LemonSqueezy environment.
LEMON_ENV=production
# App base URL used for checkout success / cancel return URLs.
APP_BASE_URL=https://hamdeva.com
# Optional Firebase Storage bucket override for Functions uploads/downloads.
APP_STORAGE_BUCKET=hamdeva.appspot.com
