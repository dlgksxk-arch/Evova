OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_CLASSIFICATION_MODEL=gpt-4.1-nano
GOOGLE_VIDEO_API_KEY=
GOOGLE_VIDEO_MODEL=veo-3.1-generate-preview
# Polar organization access token used to create checkout sessions and fetch checkout state.
POLAR_ACCESS_TOKEN=
# Polar webhook secret used to verify incoming payment webhooks.
POLAR_WEBHOOK_SECRET=
# Set to production or sandbox depending on the Polar environment.
POLAR_ENV=production
# Polar product ids.
POLAR_PRODUCT_ID_STARTER=
POLAR_PRODUCT_ID_POPULAR=
POLAR_PRODUCT_ID_PRO=
POLAR_PRODUCT_ID_SMALL_PACK=
POLAR_PRODUCT_ID_BASIC_PACK=
POLAR_PRODUCT_ID_MEDIUM_PACK=
POLAR_PRODUCT_ID_LARGE_PACK=
# App base URL used for checkout success / cancel return URLs.
APP_BASE_URL=https://hamdeva.com
# Optional Firebase Storage bucket override for Functions uploads/downloads.
APP_STORAGE_BUCKET=hamdeva.firebasestorage.app
